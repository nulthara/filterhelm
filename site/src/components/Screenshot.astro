---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.{png,svg}", { eager: true });
const source = images[`../assets/screenshots/${name}.png`] ?? images[`../assets/screenshots/${name}.svg`];
if (!source) throw new Error(`Missing screenshot slot: ${name}`);
---

<figure class="fh-shot">
  <Image src={source.default} alt={alt} width={1600} height={1000} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
