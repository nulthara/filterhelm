# Installed root-owned to /etc/containers/systemd/. See docs/deploy.md.
[Unit]
Description=FilterHelm
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/filterhelm:latest
ContainerName=filterhelm
Pull=never
Network=host
Volume=/var/lib/filterhelm:/data
EnvironmentFile=/etc/filterhelm/env
# Wins over EnvironmentFile; the volume is mounted only at /data.
Environment=FILTERHELM_DATA=/data
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
